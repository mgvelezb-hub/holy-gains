/// Few-shot de tono. Se carga desde /admin/import; nunca desde un seed público.
model TrainingExample {
  id     String  @id @default(uuid()) @db.Uuid
  userId String? @map("user_id") @db.Uuid
  user   User?   @relation("TrainingExampleAthlete", fields: [userId], references: [id], onDelete: SetNull)

  contextJson      Json                  @map("context_json")
  approvedResponse String                @map("approved_response")
  source           TrainingExampleSource @default(ADMIN)

  createdAt DateTime @default(now()) @map("created_at")

  @@map("training_examples")
}

// ---------------------------------------------------------------------------
// Household (vínculo entre cuentas)
// ---------------------------------------------------------------------------

/**
 * Vínculo entre dos cuentas que viven juntas (pareja, roommates). Hoy esta
 * tabla es solo la BASE: guarda el vínculo y nada más — no comparte ninguna
 * información todavía y no hay UI en la app que la use. Se construye ahora
 * porque lo que sí viene pronto (lista de súper compartida, ver el menú del
 * otro) necesita saber primero QUIÉN está vinculado con quién, y ese vínculo
 * debe existir de forma estable antes de decidir qué se comparte.
 *
 * Por qué CÓDIGO y no buscar por correo: dejar que una cuenta busque a otra
 * por email expondría quién más usa la app — un dato que no le corresponde
 * ver a nadie fuera de quien ya trae la invitación en la mano. El código de
 * 6 caracteres (alfabeto sin ambigüedades: A-Z sin O/I, 2-9 sin 0/1) se
 * comparte fuera de la app — de palabra, por WhatsApp — y solo sirve para
 * aceptar una invitación concreta, nunca para explorar quién existe.
 *
 * Por qué el modelo es genérico y no "GroceryListShare" o algo específico:
 * el vínculo en sí (quién está unido con quién) es independiente de QUÉ se
 * comparte. La lista de súper compartida es el primer caso de uso, pero el
 * mismo vínculo es la base para lo que siga (ver el menú del otro, por
 * ejemplo). Modelar "el vínculo" y "lo que se comparte" por separado evita
 * tener que rehacer esta tabla cuando se agregue el segundo caso de uso.
 *
 * Ciclo de vida: una invitación nace PENDIENTE con un código vigente 48
 * horas. Si alguien la acepta a tiempo pasa a ACTIVO. Cualquiera de los dos
 * — quien invitó o quien aceptó — puede disolverla en cualquier momento
 * (ACTIVO → DISUELTO), y una invitación PENDIENTE que nadie acepta también
 * puede disolverse (o expirar sola). Una cuenta solo puede tener UN vínculo
 * ACTIVO o PENDIENTE vigente a la vez — no tiene sentido compartir con más
 * de una persona en la v1, y evita el lío de reconciliar dos listas de súper
 * a la vez.
 */
model HouseholdLink {
  id String @id @default(uuid()) @db.Uuid

  /// Quién generó el código.
  inviterId String @map("inviter_id") @db.Uuid
  inviter   User   @relation("VinculosEmitidos", fields: [inviterId], references: [id], onDelete: Cascade)

  /// Quién lo aceptó. `null` mientras sigue PENDIENTE. Si la cuenta que
  /// aceptó se borra, el vínculo no debe desaparecer con ella — se queda
  /// como registro histórico con `inviteeId: null`, no se borra en cascada.
  inviteeId String? @map("invitee_id") @db.Uuid
  invitee   User?   @relation("VinculosRecibidos", fields: [inviteeId], references: [id], onDelete: SetNull)

  /// 6 caracteres, alfabeto sin ambigüedades (A-Z sin O/I, 2-9 sin 0/1).
  code String @unique

  /// `PENDIENTE` | `ACTIVO` | `DISUELTO`.
  status String @default("PENDIENTE")

  createdAt   DateTime  @default(now()) @map("created_at")
  /// Vigencia del código: 48 h después de `createdAt`.
  expiresAt   DateTime  @map("expires_at")
  acceptedAt  DateTime? @map("accepted_at")
  dissolvedAt DateTime? @map("dissolved_at")

  @@index([inviterId])
  @@index([inviteeId])
  /// Lo tachado de la lista de súper COMPARTIDA: `{ items: string[] }`.
  /// Vive en el vínculo y no en cada perfil porque la compra es del hogar:
  /// uno tacha en el súper y el otro lo ve desde la casa.
  superComprados Json?    @map("super_comprados")

  @@map("household_links")
}

/**
 * Una ronda de golf: el registro que de verdad mueve el score.
 *
 * Las métricas no son adorno — son las que la investigación del deporte
 * (Broadie, "strokes gained"; estadísticas USGA/PGA) señala como las que
 * explican el score: GIR (greens en regulación) es el mejor predictor
 * individual, putts por ronda separa el juego corto, FIR dice si el drive
 * está costando golpes y los castigos son los golpes regalados. Con esas
 * cuatro por ronda se puede decir DÓNDE se está fugando el score, que es lo
 * que un jugador de competencia necesita saber para entrenar lo correcto.
 *
 * Todo salvo el score es opcional: una ronda casual con solo score y hoyos
 * también cuenta, y exigir la tarjeta completa mataría el registro.
 */
model GolfRound {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  date  DateTime @db.Date
  /// 9 o 18.
  holes Int
  /// Par del campo (o de los hoyos jugados). Permite score relativo.
  par   Int?
  score Int

  putts          Int?
  /// Fairways embocados / fairways con oportunidad (los par 3 no cuentan).
  fairwaysHit    Int?
  fairwaysTotal  Int?
  /// Greens en regulación alcanzados.
  girHit         Int?
  penalties      Int?

  course String?
  notes  String?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, date])
  @@map("golf_rounds")
}

/**
 * Práctica de golf fuera del campo: range, juego corto o putting.
 *
 * Se separa de la ronda porque mejora cosas distintas y el balance importa:
 * la evidencia del deporte es consistente en que el juego corto y el putting
 * explican más score del que se les practica. Registrar el TIPO de práctica
 * es lo que permite enseñar ese desbalance.
 */
model GolfPractice {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  date    DateTime @db.Date
  /// RANGE | JUEGO_CORTO | PUTTING.
  kind    String
  minutes Int
  /// Bolas pegadas, cuando se cuentan.
  balls   Int?
  notes   String?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, date])
  @@map("golf_practices")
}
