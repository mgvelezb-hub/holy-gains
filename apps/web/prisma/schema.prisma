// Coachy — modelo de datos (spec 03 §5, adaptado a Supabase).
//
// `User.id` es exactamente el `id` de `auth.users` de Supabase. El trigger
// `handle_new_user` (ver supabase/setup.sql) crea la fila en `public.users`
// cuando alguien se registra. `Profile` se crea en el onboarding.
//
// Medidas corporales: Decimal(5,1) — cm y kg con un decimal.
// El repo es público: aquí no vive ningún dato personal, solo el esquema.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  ATHLETE
}

enum Sex {
  FEMALE
  MALE
  OTHER
}

enum Phase {
  REINTRO
  BASE
  CUT
  CUT_AGRESIVO
  REFEED
  ESTABILIZACION
  MANTENIMIENTO
}

enum Goal {
  RECOMPOSICION
  PERDIDA_GRASA
  GANANCIA_MUSCULO
  SALUD
  RENDIMIENTO
}

enum WorkSchedule {
  SEDENTARIO
  ACTIVO
}

enum TrainingTime {
  MANANA
  MEDIODIA
  TARDE
  NOCHE
}

enum Budget {
  BAJO
  MEDIO
  ALTO
}

enum StrengthTrend {
  SUBE
  IGUAL
  BAJA
}

enum CyclePhase {
  FOLICULAR
  OVULACION
  LUTEA
  MENSTRUACION
  NA
}

enum PhotoView {
  FRENTE
  PERFIL
  ESPALDA
}

enum DecisionStatus {
  PENDIENTE
  APROBADA
  CORREGIDA
}

enum ConversationRole {
  COACHY
  ATHLETE
}

enum TrainingExampleSource {
  COACH
  ADMIN
}

enum NotificationKind {
  /// Sábado: recordatorio de medidas y fotos.
  RECORDATORIO_CHECKIN
  /// Miércoles: no llegó el check-in del domingo.
  CHECKIN_PENDIENTE
  /// El admin aprobó la decisión: ya hay mensaje de Coachy.
  MENSAJE_COACHY
  /// Aviso al admin: 2 semanas sin check-in de alguien.
  ALERTA_ABANDONO
  /// Aviso al admin: una señal de escalamiento del observatorio (Fase 3).
  /// Notifica, nunca bloquea: la decisión del motor ya se publicó.
  ESCALAMIENTO
}

/// Disciplina de una `ActivitySession`. `PESAS` puede aparecer aquí (p. ej.
/// una pesas sincronizada desde HealthKit), pero el registro serie a serie
/// del modo gimnasio sigue viviendo en `Workout`/`WorkoutSet` — este modelo
/// no lo reemplaza, cubre lo que ese par no sabe registrar: natación, box,
/// squash, CrossFit, funcional.
enum Discipline {
  PESAS
  FUNCIONAL
  CROSSFIT
  NATACION
  BOX
  SQUASH
  CARDIO
  GOLF
  OTRO
}

/// Estilo de dieta. Cada uno cambia una cosa: el ayuno los horarios, la
/// vegetariana el catálogo, la keto el reparto de macros.
enum DietStyle {
  ESTANDAR
  AYUNO
  VEGETARIANA
  KETO
  /// El mismo menú todos los días de la semana, con ajuste programado por
  /// fase. Es el formato de cualquier coach de gimnasio en México: la
  /// variedad diaria que rota el motor es ruido para quien prepara su comida
  /// el domingo y quiere repetirla.
  MENU_FIJO
}

/// Nivel de natación declarado por la atleta. Ordena volumen y descansos.
enum SwimLevel {
  PRINCIPIANTE
  INTERMEDIO
  AVANZADO
}

/// De dónde entró la sesión: capturada a mano en la app, o sincronizada desde
/// HealthKit (Apple Watch / Salud).
enum ActivitySource {
  APP
  HEALTHKIT
}

// ---------------------------------------------------------------------------
// Identidad
// ---------------------------------------------------------------------------

model User {
  /// Mismo UUID que `auth.users.id` en Supabase.
  id        String   @id @db.Uuid
  email     String   @unique
  role      Role     @default(ATHLETE)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  profile            Profile?
  checkIns           CheckIn[]
  decisions          Decision[]
  workouts           Workout[]
  healthDays         HealthDay[]
  activitySessions   ActivitySession[]
  labResults         LabResult[]
  mealLogs           MealLog[]
  supplementLogs     SupplementLog[]
  customFoods        CustomFood[]
  conversations      Conversation[]
  notifications      Notification[]
  trainingExamples   TrainingExample[] @relation("TrainingExampleAthlete")
  correctedDecisions Decision[]        @relation("DecisionCorrectedBy")
  vinculosEmitidos   HouseholdLink[]   @relation("VinculosEmitidos")
  vinculosRecibidos  HouseholdLink[]   @relation("VinculosRecibidos")
  golfRounds         GolfRound[]
  golfPractices      GolfPractice[]

  @@map("users")
}

/// Perfil del atleta: resultado del cuestionario de onboarding.
model Profile {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  displayName String    @map("display_name")
  sex         Sex
  birthDate   DateTime? @map("birth_date") @db.Date
  /**
   * Rango de edad, para quien no quiere dar su fecha exacta: `25_34`.
   *
   * El motor necesita una edad para el gasto basal. Sin fecha ni rango usa 30
   * años, que es una suposición; con el rango usa su punto medio, que sigue
   * siendo aproximado pero es lo que la persona sí declaró.
   */
  ageRange    String?   @map("age_range")
  heightCm    Decimal   @map("height_cm") @db.Decimal(5, 1)
  weightKg    Decimal?  @map("weight_kg") @db.Decimal(5, 1)
  leanMassKg  Decimal?  @map("lean_mass_kg") @db.Decimal(5, 1)

  liftingDays      Int          @default(4) @map("lifting_days")
  cardioMinWk      Int          @default(0) @map("cardio_min_wk")
  /// Minutos por sesión. 45 ⇒ 4-5 ejercicios; 60+ ⇒ 6-8 (metodología §3).
  sessionMinutes   Int          @default(60) @map("session_minutes")
  work             WorkSchedule @default(SEDENTARIO)
  trainingTime     TrainingTime @default(MANANA) @map("training_time")
  /**
   * Horario por día {LUN..DOM: MANANA|MEDIODIA|TARDE|NOCHE|DESCANSO}; null = mismo horario todos los días.
   */
  trainingSchedule Json?        @map("training_schedule")
  mealsPerDay      Int          @default(4) @map("meals_per_day")
  budget           Budget       @default(MEDIO)

  favoriteFoods String[] @map("favorite_foods")
  excludedFoods String[] @map("excluded_foods")
  /// Minutos de cocina que esta persona acepta por preparación. `null` = sin
  /// tope. El motor descarta los alimentos que pidan más, salvo que el tope
  /// deje un rol sin con qué comer (ahí manda comer, no el tope).
  maxPrepMin    Int?     @map("max_prep_min")

  /**
   * Cómo quiere ver su Resumen: qué paneles, en qué orden, con cuánto detalle
   * y de qué ancho.
   *
   * `[{ "id": "cintura", "variante": "normal", "ancho": "medio" }]` — el orden
   * del arreglo ES el orden en pantalla, y lo que no aparece está oculto. Vive
   * en el perfil y no solo en el teléfono para que sobreviva a un cambio de
   * aparato: reconstruir el tablero a mano es justo el trabajo que nadie
   * repite.
   */
  summaryLayout Json? @map("summary_layout")

  /**
   * Referencia NUMÉRICA del objetivo: las medidas publicadas de la persona que
   * se tomó como norte, con su estatura y su sexo.
   *
   * Las fotos de referencia dan una lectura ordinal —de una foto no salen
   * centímetros—; esto da metas con número. No se copian tal cual: la app las
   * escala por proporción y se niega a trasladar el porcentaje de grasa entre
   * sexos (`apps/mobile/src/lib/referencia.ts`).
   */
  goalReference Json? @map("goal_reference")

  // -- Estilo de dieta (Fase 8) ---------------------------------------------
  /// Qué método sigue el plan. Se elige explícitamente: una IA que decide sola
  /// tu filosofía nutricional es justo la caja negra que este diseño evita.
  dietStyle        DietStyle @default(ESTANDAR) @map("diet_style")
  /// Suplementos que la persona TIENE: `WHEY`, `CREATINA`, `OMEGA3`.
  ///
  /// No es una lista de recomendaciones. El plan solo sugiere lo que ya se
  /// puede tomar, y el menú no reparte polvos de proteína a quien no los
  /// declaró — un menú con 30 g de whey para quien no tiene whey no se puede
  /// seguir.
  supplements      String[]
  /**
   * Suplementos sugeridos por el motor que la persona aceptó o descartó:
   * `{"MAGNESIO": "acepto", "ASHWAGANDHA": "no_quiero", "VITAMINA_D": "ya_lo_tomo"}`.
   * El motor sugiere con motivo y evidencia; la persona decide. Lo aceptado
   * pasa a `supplements`; lo descartado no vuelve a sugerirse.
   */
  supplementChoices Json?    @map("supplement_choices")
  /// Ventana de alimentación para el ayuno, en horas locales (0-23).
  /// `null` = 12:00-20:00, el 16/8 de uso más común.
  fastingStartHour Int?      @map("fasting_start_hour")
  fastingEndHour   Int?      @map("fasting_end_hour")
  allergies     String[]
  /// Etiquetas libres: glucosa_alta, lesion_activa, ciclo_tracking, ...
  conditions    String[]

  goal         Goal  @default(RECOMPOSICION)
  currentPhase Phase @default(REINTRO)

  // -- Preferencias que mandan sobre la planeación (Fase 6) ------------------
  /// Grupos musculares que esta persona no quiere repetir en la semana
  /// (`PIERNA`, `HOMBRO`, ...). El split entrena el grupo una vez y reemplaza
  /// las repeticiones por trabajo del resto del cuerpo — la misma maquinaria
  /// del protocolo de lesión, por otra razón.
  avoidRepeatGroups String[] @map("avoid_repeat_groups")
  /// La disciplina que arma el esqueleto de la semana. Hoy solo `PESAS` tiene
  /// generador; las demás se registran y gastan presupuesto, y su prescripción
  /// llega una a una (Fase 7, natación primero).
  primaryDiscipline Discipline @default(PESAS) @map("primary_discipline")
  /// Nivel en el agua. Queda por compatibilidad: el nivel de cada disciplina
  /// vive en `disciplineLevels`, y natación lee de ahí con esto como respaldo.
  swimLevel         SwimLevel  @default(PRINCIPIANTE) @map("swim_level")
  /**
   * Nivel declarado por disciplina:
   * `{ "NATACION": "INTERMEDIO", "BOX": "PRINCIPIANTE" }`.
   *
   * Se declara y no se infiere: el reloj sabe cuánto duró tu sesión, no si
   * sabes caer de una caja o respirar de tres. Prescribir por encima del nivel
   * real es como se lesiona la gente.
   */
  disciplineLevels  Json?      @map("discipline_levels")
  /// Disciplinas además de la primaria, con cuántas sesiones a la semana:
  /// `[{ "discipline": "NATACION", "sessionsPerWeek": 2, "proposito": "COMPLEMENTO", "importancia": 2 }]`.
  /// Gastan del presupuesto semanal: agregar una no suma días encima, se los
  /// quita a las pesas. `proposito` e `importancia` son lo que la persona
  /// contestó al replanificar (ver `replan.ts`) — antes se preguntaban y se
  /// tiraban, y la pantalla de recalibrar tenía que adivinar la importancia
  /// contando sesiones.
  otherDisciplines  Json?      @map("other_disciplines")
  /**
   * Minutos disponibles por día, tal como la persona los declaró al
   * replanificar: `{"LUN": 60, "MAR": 90, ..., "DOM": 0}`. `null` = todavía
   * no se ha declarado y el planificador usa sus defaults.
   *
   * Es lo que hace honesto el reparto de un día combinado: sin esto, dos
   * bloques de una sesión compartida se repartían 60 minutos imaginarios
   * (`DEFAULT_MINUTES` de `disciplines.ts`) en vez del tiempo real del día.
   */
  timePerDay        Json?      @map("time_per_day")
  /**
   * Si el planificador debe COMBINAR disciplinas compatibles el mismo día
   * (`true`) o darle a cada una su propio día (`false`).
   *
   * Default `true` porque el reporte que originó este campo es justo el caso
   * típico: quien declara varias disciplinas (gimnasio + natación + squash)
   * casi siempre quiere concentrarlas y quedarse con más días de descanso
   * completo, no repartirlas por default y descubrir después que existía la
   * opción de juntarlas. Quien de verdad prefiere una disciplina por día —
   * sesiones más frescas, a costa de menos descanso— lo apaga con un toque en
   * Ajustes; no es una migración de datos, es una preferencia declarada.
   */
  compactDays       Boolean    @default(true) @map("compact_days")

  /**
   * Bloques que se cambiaron por fecha: `{"2026-09-01": "PESAS"}`.
   *
   * Pasa todo el tiempo: hoy tocaba squash pero la cancha estaba ocupada, o
   * llovió, o no se pudo llegar. Antes la única salida era no entrenar o
   * registrar una sesión libre a mano y quedarse sin rutina; ahora ese día
   * cambia de disciplina y, si se cambia a pesas, la sesión de gimnasio se
   * materializa igual que cualquier otra.
   *
   * Es por FECHA, no por día de la semana: es una excepción de hoy, no un
   * cambio de plan. El plan se cambia en Ajustes.
   */
  blockOverrides    Json?      @map("block_overrides")

  /**
   * Ejercicios que esta persona ya cambió, y por cuál: `{"press_banca":
   * "press_inclinado_mancuerna"}`.
   *
   * Cambiar un ejercicio a media sesión resolvía ese día y nada más: a la
   * semana siguiente el generador volvía a proponer el mismo que ya se había
   * rechazado, y había que cambiarlo otra vez. Un cambio repetido es una
   * preferencia, no una casualidad, y aquí se recuerda.
   *
   * El generador la respeta solo si el reemplazo sigue siendo válido para ese
   * hueco (mismo grupo, permitido por lesiones): la preferencia no puede
   * romper el plan.
   */
  exerciseSwaps     Json?      @map("exercise_swaps")

  /**
   * Estilo de esquema fijo que la persona eligió en preferencias:
   * `RECOMENDADO | FUERZA | HIPERTROFIA | METABOLICO` (`SCHEME_PREFERENCES`
   * en `schemes.ts`).
   *
   * `RECOMENDADO` (default) deja que `schemeForWeek` siga rotando piramidal →
   * fuerza → metabólico → rango medio semana a semana — la periodización
   * ondulante es igual o superior a la lineal para fuerza (Rhea et al.
   * 2002), y por eso la rotación sigue siendo la recomendación. Los demás
   * valores fijan un esquema todas las semanas, para quien prefiere no
   * variar. `TEXT` y no un enum de Postgres porque este catálogo puede crecer
   * sin migración; `schemeForWeek` valida el valor y cualquier cosa que no
   * reconozca cae de vuelta a `RECOMENDADO` (ver `toTrainingProfile` en
   * `db.ts`). Los días de REHAB nunca respetan esto: la lesión manda sobre la
   * preferencia (ver `schemeForExercise`).
   */
  schemePreference  String     @default("RECOMENDADO") @map("scheme_preference")

  /**
   * Horarios de comida propios: `{ "DESAYUNO": "07:30", "COMIDA": "15:00" }`.
   *
   * El motor reparte los macros por tiempo de comida y trae una hora sugerida
   * para cada uno, pero esa hora sale de una jornada estándar que no es la de
   * todo el mundo: quien entra a trabajar a las 6, quien come a las 4 de la
   * tarde o quien entrena de noche estaba viendo horas que no iba a cumplir,
   * y un horario que no se cumple vuelve inútil el recordatorio.
   *
   * Solo se guardan los tiempos que la persona movió; los demás siguen con la
   * sugerencia del motor. `null` = ninguno movido.
   */
  mealTimes         Json?      @map("meal_times")

  /**
   * Horarios distintos por día de la semana: `{"SAB": {"DESAYUNO": "10:00"},
   * "DOM": {...}}`. Solo los días que difieren del horario general; los demás
   * usan `mealTimes`. Nació del fin de semana: nadie desayuna a las 7 el
   * sábado y el recordatorio de las 7 se vuelve ruido.
   */
  mealTimesByDay    Json?      @map("meal_times_by_day")

  /**
   * Split fijado por la persona, por día de la semana: `{"LUN":
   * "PIERNA_CUADRICEPS", "MAR": "PECHO_TRICEP", ...}`. `null` = el motor
   * elige el split por número de días. Cuando existe, el motor lo respeta y
   * solo avisa si viola vecindad (hombro el día antes de pecho/espalda).
   */
  customSplit       Json?      @map("custom_split")

  /**
   * Lo que la persona ya tiene en casa: `["pechuga_pollo", "arroz_integral",
   * ...]` (ids del catálogo). El motor los prefiere al armar la semana. Nació
   * de un cambio de motor que dejó despensas compradas con el menú viejo sin
   * uso: la comida comprada manda sobre la variedad.
   */
  pantry            Json?      @map("pantry")

  /**
   * Ejercicios elegidos a mano por tipo de día: `{"PECHO_TRICEP":
   * ["press_banca", "aperturas", ...]}`. `null` = sigue la sugerencia de
   * Coachy. Cuando existe, el generador usa esa lista en ese orden y solo
   * completa con sugerencia si falta volumen.
   */
  manualExercises   Json?      @map("manual_exercises")

  /**
   * Bloques agregados a un día concreto, además de la disciplina base:
   * `{"2026-09-04": [{"discipline": "NATACION", "tipo": "ENTRENO", "minutos": 40}]}`.
   * `tipo` = `ENTRENO` (Coachy prescribe la sesión) o `LIBRE` (solo se
   * registra tiempo y datos del reloj). Es la forma nueva de convivir
   * disciplinas: se deciden el día, con el tiempo que sobra, no en el plan.
   */
  dayBlocks         Json?      @map("day_blocks")

  /**
   * Cuál de los dos menús de la semana quiere cocinar: `AMBOS` (por defecto,
   * se reparten la semana), `MENU_1` o `MENU_2`.
   *
   * Cambia la lista de súper, que es el punto: comprar los ingredientes de
   * dos menús cuando solo se va a cocinar uno es tirar comida y dinero.
   */
  menuPreference    String     @default("AMBOS") @map("menu_preference")

  /**
   * El "punto cero": el check-in que la persona declaró como su referencia.
   *
   * Quien vuelve después de meses parada arrastra un historial que ya no la
   * describe, y comparar contra su primer registro de hace un año convierte
   * cualquier avance real en un retroceso en pantalla. Al marcar un check-in
   * como punto cero, todo lo que compara —avances, gráficas, fotos— arranca
   * ahí. El historial viejo NO se borra: deja de ser la vara.
   *
   * `null` = sin punto cero declarado: la vara es el primer check-in, que es
   * como funcionaba antes de que esto existiera.
   */
  baselineCheckInId String?   @unique @map("baseline_check_in_id") @db.Uuid
  baselineCheckIn   CheckIn?  @relation("PuntoCero", fields: [baselineCheckInId], references: [id], onDelete: SetNull)

  /// Overrides de la config del motor (spec 02 §7). Null = defaults.
  engineConfig Json? @map("engine_config")

  /// Consentimiento explícito para análisis de fotos con IA.
  photoConsentAt      DateTime? @map("photo_consent_at")
  photoConsentVersion String?   @map("photo_consent_version")

  // -- Ciclo menstrual (Fase 7) ---------------------------------------------
  // Opt-in explícito. Es dato de salud y es de la atleta: el admin nunca ve la
  // fase, solo "semana no concluyente". `supabase/setup-f3f7.sql` revoca el
  // privilegio de lectura de estas tres columnas a los roles del cliente.
  //
  // Estimación de calendario, jamás diagnóstico ni anticoncepción.
  cycleTrackingEnabled Boolean   @default(false) @map("cycle_tracking_enabled")
  /// Primer día del último periodo, tal como ella lo escribió.
  cycleLastPeriodStart DateTime? @map("cycle_last_period_start") @db.Date
  /// Duración típica del ciclo en días (21-45).
  cycleAvgLength       Int       @default(28) @map("cycle_avg_length")

  // -- Cierre de semana -----------------------------------------------------
  /// Día en que esta persona cierra su semana y hace check-in (0 = domingo).
  /// `null` = todavía no lo eligió; la app asume domingo.
  checkinWeekday Int? @map("checkin_weekday")
  /// Hora local del recordatorio, 0-23. `null` = sin recordatorio.
  checkinHour    Int? @map("checkin_hour")

  // -- Salud / wearables (Fase 8) -------------------------------------------
  /// Token del Atajo de iOS que sube pasos y sueño a `/api/health/ingest`.
  /// Es una credencial: se genera a la primera visita y se puede regenerar.
  healthIngestToken String? @unique @map("health_ingest_token") @db.Uuid

  onboardingCompletedAt DateTime? @map("onboarding_completed_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@map("profiles")
}

// ---------------------------------------------------------------------------
// Check-in semanal
// ---------------------------------------------------------------------------

model CheckIn {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  date DateTime @db.Date

  // Medidas (cm) y peso (kg)
  weightKg   Decimal? @map("weight_kg") @db.Decimal(5, 1)
  waistCm    Decimal? @map("waist_cm") @db.Decimal(5, 1)
  legLeftCm  Decimal? @map("leg_left_cm") @db.Decimal(5, 1)
  legRightCm Decimal? @map("leg_right_cm") @db.Decimal(5, 1)
  armLeftCm  Decimal? @map("arm_left_cm") @db.Decimal(5, 1)
  armRightCm Decimal? @map("arm_right_cm") @db.Decimal(5, 1)

  // Sensaciones 1-5
  inflammation Int
  energy       Int
  hunger       Int
  satiety      Int
  sleep        Int

  // Fuerza
  strengthRpe   Int?           @map("strength_rpe")
  strengthTrend StrengthTrend? @map("strength_trend")

  // Cumplimiento 0-100
  dietCompliance     Int @map("diet_compliance")
  trainingCompliance Int @map("training_compliance")

  symptoms   String[]
  cyclePhase CyclePhase? @map("cycle_phase")
  comment    String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  photos   Photo[]
  decision Decision?
  /// Perfiles que declararon este check-in como su punto cero (a lo mas uno).
  puntoCeroDe Profile[] @relation("PuntoCero")

  @@unique([userId, date])
  @@index([userId, date])
  @@map("checkins")
}

model Photo {
  id        String  @id @default(uuid()) @db.Uuid
  checkInId String  @map("checkin_id") @db.Uuid
  checkIn   CheckIn @relation(fields: [checkInId], references: [id], onDelete: Cascade)

  view PhotoView

  /// Ruta dentro del bucket privado `progress-photos`:
  /// `{user_id}/{checkin_id}/{vista}.jpg`. Nunca una URL pública.
  storagePath String @map("storage_path")

  /// Salida estructurada del análisis de visión (Fase 2+).
  analysisJson Json? @map("analysis_json")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([checkInId, view])
  @@map("photos")
}

// ---------------------------------------------------------------------------
// Decisión del motor
// ---------------------------------------------------------------------------

model Decision {
  id        String  @id @default(uuid()) @db.Uuid
  checkInId String  @unique @map("checkin_id") @db.Uuid
  checkIn   CheckIn @relation(fields: [checkInId], references: [id], onDelete: Cascade)

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  phase    Phase
  kcal     Int
  proteinG Int   @map("protein_g")
  fatG     Int   @map("fat_g")
  carbsG   Int   @map("carbs_g")
  fiberG   Int?  @map("fiber_g")

  /// `rulesFired[]` del motor: [{ id, explicacion }]
  rules       Json   @default("[]")
  explanation String

  /// Semilla quincenal del motor: dice cuándo toca refrescar el menú.
  menuSeed Int? @map("menu_seed")

  /// Ids del banco de preguntas que se le hicieron al atleta esta semana.
  /// Se usan para no repetir la misma pregunta dos semanas seguidas.
  questionIds String[] @map("question_ids")

  /// Respuesta de Coachy ya redactada: { celebracion, preguntas[], comparacion,
  /// decision_texto, meta, cierre }. Null si la redacción falló o no corrió.
  replyJson Json? @map("reply_json")

  /// Análisis de fotos agregado por zona (visión). Null si no hubo consentimiento
  /// o `VISION_ENABLED` está apagado.
  visionJson Json? @map("vision_json")

  /// Momento en que la decisión quedó visible para el atleta.
  publishedAt DateTime? @map("published_at")

  status        DecisionStatus @default(PENDIENTE)
  correctedById String?        @map("corrected_by_id") @db.Uuid
  correctedBy   User?          @relation("DecisionCorrectedBy", fields: [correctedById], references: [id])
  correctedJson Json?          @map("corrected_json")
  approvedAt    DateTime?      @map("approved_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  mealPlans MealPlan[]

  @@index([userId, status])
  @@map("decisions")
}

model MealPlan {
  id         String   @id @default(uuid()) @db.Uuid
  decisionId String   @map("decision_id") @db.Uuid
  decision   Decision @relation(fields: [decisionId], references: [id], onDelete: Cascade)

  menuNumber       Int  @map("menu_number")
  mealsJson        Json @map("meals_json")
  equivalencesJson Json @map("equivalences_json")
  groceryListJson  Json @map("grocery_list_json")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([decisionId, menuNumber])
  @@map("meal_plans")
}

// ---------------------------------------------------------------------------
// Entrenamiento
// ---------------------------------------------------------------------------

/// Una sesión del día: lo que el generador planeó (`exercises_json`) y el
/// resumen de lo que pasó en el gimnasio (`loads_json`). El detalle serie a
/// serie vive en `workout_sets`, que es lo que se consulta para progresión y PRs.
model Workout {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  date        DateTime @db.Date
  muscleGroup String   @map("muscle_group")
  scheme      String

  exercisesJson Json  @map("exercises_json")
  /// Resumen de la sesión: { volumeKg, prs[], rpeByExercise, notes }.
  loadsJson     Json? @map("loads_json")

  /// Momento en que la atleta cerró la sesión. Null = planeada, no entrenada.
  completedAt DateTime? @map("completed_at")

  /// Minutos a los que se recortó la sesión cuando la atleta dijo que tenía
  /// menos tiempo. `null` = sesión completa. Se guarda para que la retro del
  /// check-in distinga "entrené menos" de "no entrené": no son lo mismo, y sin
  /// esta marca tres semanas de prisa se leerían como falta de disciplina.
  trimmedMinutes Int? @map("trimmed_minutes")

  createdAt DateTime @default(now()) @map("created_at")

  sets WorkoutSet[]

  @@unique([userId, date])
  @@index([userId, date])
  @@map("workouts")
}

/// Una serie ejecutada. Es la unidad que sincroniza el modo gimnasio desde el
/// teléfono: `client_id` la hace idempotente, así que reintentar la cola
/// offline nunca duplica.
model WorkoutSet {
  id        String  @id @default(uuid()) @db.Uuid
  workoutId String  @map("workout_id") @db.Uuid
  workout   Workout @relation(fields: [workoutId], references: [id], onDelete: Cascade)

  exerciseId String?   @map("exercise_id") @db.Uuid
  exercise   Exercise? @relation(fields: [exerciseId], references: [id], onDelete: SetNull)

  /// Nombre tal como se planeó: sobrevive aunque el catálogo cambie.
  exerciseName String @map("exercise_name")

  setIndex   Int      @map("set_index")
  targetReps Int      @map("target_reps")
  reps       Int
  weightKg   Decimal? @map("weight_kg") @db.Decimal(6, 2)
  rpe        Int?
  /// Serie de calentamiento: no cuenta para volumen, PRs ni progresión.
  warmup     Boolean  @default(false)

  /// Llave de idempotencia generada en el dispositivo.
  clientId String @map("client_id")

  performedAt DateTime @default(now()) @map("performed_at")

  @@unique([workoutId, clientId])
  @@index([workoutId])
  @@index([exerciseId])
  @@map("workout_sets")
}

/// Un día de datos del reloj (Fase 8): pasos, energía activa, minutos de
/// ejercicio, sueño y frecuencia cardiaca en reposo.
///
/// No hay app nativa: los sube un Atajo de iOS que lee Salud y hace POST a
/// `/api/health/ingest` con el token del atleta. Un día es una fila —
/// `(user_id, date)` es único, así que reenviar el mismo día corrige y nunca
/// duplica. Todos los campos son opcionales: el reloj puede no traer sueño, y
/// medio dato sigue siendo dato.
model HealthDay {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  date DateTime @db.Date

  steps       Int?
  activeKcal  Int? @map("active_kcal")
  exerciseMin Int? @map("exercise_min")
  /// Minutos dormidos esa noche (la que termina esa mañana).
  sleepMin    Int? @map("sleep_min")
  restingHr   Int? @map("resting_hr")

  // --- Indicadores de recuperación y capacidad (Fase 2 de tracking) ---
  /// Variabilidad de la frecuencia cardiaca (SDNN, ms). El proxy de
  /// recuperación más usado: baja sostenida = fatiga acumulada o estrés.
  hrvMs           Int?     @map("hrv_ms")
  /// VO₂ máx estimado por el reloj (mL/kg/min). Cambia de mes en mes, no de
  /// día en día — por eso se guarda el último valor conocido de cada día.
  vo2max          Decimal? @map("vo2max") @db.Decimal(4, 1)
  /// Frecuencia respiratoria en reposo (respiraciones por minuto).
  respiratoryRate Decimal? @map("respiratory_rate") @db.Decimal(4, 1)
  /// Saturación de oxígeno (%). Solo se guarda y se grafica: la app NUNCA la
  /// interpreta clínicamente.
  spo2            Decimal? @map("spo2") @db.Decimal(4, 1)
  /// Horas del día en que hubo al menos un minuto de pie (anillo de Apple).
  standHours      Int?     @map("stand_hours")

  /// De dónde vino: `atajo-ios` por default. Sirve para saber qué confiar.
  source String @default("atajo-ios")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, date])
  @@index([userId, date])
  @@map("health_days")
}

/// Registro (no prescripción) de una sesión de cualquier disciplina que no
/// sea el modo gimnasio de pesas: natación, box, squash, CrossFit, funcional,
/// cardio. El objetivo es que la sesión exista, se vea y cuente para la
/// racha — no generar la rutina de esa disciplina.
///
/// Idempotencia: `(user_id, source, external_id)` es único. Para
/// `HEALTHKIT`, `external_id` es el UUID del workout que da HealthKit —
/// reenviar la misma sesión (p. ej. HealthKit todavía la está cerrando y
/// llegan varios POST) corrige la fila existente en vez de duplicarla. Para
/// `APP` (capturada a mano, sin UUID externo) `external_id` se deja `NULL`;
/// Postgres trata cada `NULL` de un índice único como distinto de los demás,
/// así que dos sesiones manuales nunca "colisionan" entre sí — no hay nada
/// natural con qué des-duplicarlas, y cada POST debe crear una fila nueva.
model ActivitySession {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  discipline Discipline
  source     ActivitySource

  /// UUID del workout de HealthKit. `null` cuando `source = APP`.
  externalId String? @map("external_id")

  startedAt DateTime  @map("started_at")
  endedAt   DateTime? @map("ended_at")
  /// Día local de la sesión, para agrupar igual que `CheckIn`/`HealthDay`.
  date      DateTime  @db.Date

  durationMin Int  @map("duration_min")
  activeKcal  Int? @map("active_kcal")
  avgHr       Int? @map("avg_hr")
  maxHr       Int? @map("max_hr")
  distanceM   Int? @map("distance_m")

  notes String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, source, externalId])
  @@index([userId, startedAt])
  @@map("activity_sessions")
}

/// Catálogo genérico de ejercicios (seed público, sin datos personales).
model Exercise {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  muscleGroup String   @map("muscle_group")
  poolRole    String   @map("pool_role")
  videoUrl    String?  @map("video_url")
  /// Licencia del video actual: `CC-BY-SA 4.0` (wger.de) o `Dominio público` (free-exercise-db). Null si no hay video o es material propio.
  videoLicense String? @map("video_license")
  /// Autor a acreditar cuando la licencia lo exige (wger.de). Null en dominio público o sin video.
  videoAuthor String?  @map("video_author")
  /// De dónde salió el video: `wger.de` o `free-exercise-db`. Null si no hay video.
  videoSource String?  @map("video_source")
  substitutes String[]
  /// Ejercicio trazador: se registra carga cada semana.
  isTracker   Boolean  @default(false) @map("is_tracker")

  /**
   * Nivel al que se prescribe: `PRINCIPIANTE`, `INTERMEDIO`, `AVANZADO`.
   *
   * El generador solo elige ejercicios del nivel de la atleta o por debajo.
   * Mandar una sentadilla búlgara o un peso muerto a barra libre a quien
   * lleva dos semanas no es exigencia, es la forma más común de lesionarse en
   * un gimnasio.
   */
  level       String   @default("PRINCIPIANTE")
  /// Con qué se hace: `BARRA`, `MANCUERNA`, `MAQUINA`, `POLEA`, `PESO_CORPORAL`.
  equipment   String   @default("MAQUINA")
  /// Cómo se ejecuta, para la biblioteca.
  howTo       String?  @map("how_to")
  /// Para qué sirve.
  whyFor      String?  @map("why_for")
  /// El error más común.
  watchOut    String?  @map("watch_out")

  createdAt DateTime @default(now()) @map("created_at")

  workoutSets WorkoutSet[]

  @@index([muscleGroup])
  @@map("exercises")
}

/// Catálogo genérico de alimentos, macros por 100 g.
model Food {
  id       String   @id @default(uuid()) @db.Uuid
  name     String   @unique
  role     String
  kcal     Decimal  @db.Decimal(6, 2)
  proteinG Decimal  @map("protein_g") @db.Decimal(6, 2)
  carbsG   Decimal  @map("carbs_g") @db.Decimal(6, 2)
  fatG     Decimal  @map("fat_g") @db.Decimal(6, 2)
  fiberG   Decimal  @default(0) @map("fiber_g") @db.Decimal(6, 2)
  gi       Int?
  costRel  Int      @default(2) @map("cost_rel")
  prepMin  Int      @default(10) @map("prep_min")
  tags     String[]

  createdAt DateTime @default(now()) @map("created_at")

  @@index([role])
  @@map("foods")
}

/// Una comida del plan, confirmada o no por la atleta.
///
/// Existe para que el apego a la dieta deje de ser un número que se recuerda
/// el domingo: cada comida se confirma en el momento, con un toque desde la
/// notificación. El check-in llega prellenado con la cuenta real y la semana
/// deja de depender de la memoria.
/// Alimento que la persona dio de alta porque no estaba en el catálogo
/// (el yogur de su marca, la proteína que compra). Entra al motor con las
/// mismas reglas que cualquier alimento del catálogo: rol, macros por 100 g,
/// porción casera y tope. Si la planeación no lo pide, no entra; si sí, se
/// considera igual que los demás.
model CustomFood {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Nombre como lo escribió la persona ("Yogurt griego Oikos").
  name String
  /// Rol del motor: `proteina_magra`, `proteina_grasa`, `carbo_complejo`,
  /// `carbo_pre`, `carbo_post`, `grasa`, `fruta`, `vegetal_libre`.
  role String

  proteinPer100 Decimal @map("protein_per_100") @db.Decimal(6, 2)
  carbPer100    Decimal @map("carb_per_100") @db.Decimal(6, 2)
  fatPer100     Decimal @map("fat_per_100") @db.Decimal(6, 2)
  fiberPer100   Decimal @default(0) @map("fiber_per_100") @db.Decimal(6, 2)

  /// Porción casera: unidad, gramos por unidad y rango de unidades por comida.
  servingUnit  String @map("serving_unit")
  gramsPerUnit Decimal @map("grams_per_unit") @db.Decimal(7, 2)
  minUnits     Decimal @map("min_units") @db.Decimal(5, 2)
  maxUnits     Decimal @map("max_units") @db.Decimal(5, 2)

  /// Etiquetas del motor que apliquen (`vegetariano`, `sin_cocinar`, `cereal_desayuno`, ...).
  tags String[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("custom_foods")
}

/// Toma registrada de un suplemento. Sin esto la pauta es un letrero: con
/// esto se sabe si la creatina se toma todos los días, que es lo único que
/// hace que funcione.
model SupplementLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date       DateTime @db.Date
  supplement String
  taken      Boolean
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([userId, date, supplement])
  @@index([userId, date])
  @@map("supplement_logs")
}

model MealLog {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Día de la comida, en la zona de la atleta.
  date DateTime @db.Date
  /// Qué comida del día: `PRE`, `POST`, `DESAYUNO`, `COMIDA`, `SNACK`, `CENA`.
  slot String
  /// `true` = la hizo como venía; `false` = la saltó o comió otra cosa.
  taken Boolean
  /// Hora planeada del slot ese día (`"14:30"`), copiada al registrar para que
  /// el desfase se pueda medir aunque después se muevan los horarios.
  plannedAt String?   @map("planned_at")
  /// Cuándo la comió de verdad. `null` si no la comió o no dijo la hora. Es la
  /// señal con la que el ciclo semanal propone mover horarios.
  takenAt   DateTime? @map("taken_at")
  /// Por qué no la hizo: `sin_hambre`, `sin_tiempo`, `comi_otra_cosa`.
  skipped   String?

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, date, slot])
  @@index([userId, date])
  @@map("meal_logs")
}

/// Qué tipo de estudio se cargó.
enum LabKind {
  /// Bioimpedancia (InBody y equivalentes).
  INBODY
  /// Química sanguínea y perfiles de laboratorio.
  QUIMICA
}

/// Un estudio cargado por la atleta (Fase 8).
///
/// **La app guarda y grafica. No interpreta.** No hay rangos de referencia
/// propios: si el laboratorio imprimió los suyos, se capturan y se dibujan
/// como banda; si no, el valor se grafica solo. Decir "tu glucosa está alta"
/// sería diagnosticar, y eso lo hace un médico con el paciente enfrente.
model LabResult {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  kind    LabKind
  /// Fecha del estudio, no la de captura.
  takenOn DateTime @map("taken_on") @db.Date

  /**
   * Valores del estudio:
   * `[{ "key": "glucosa", "label": "Glucosa", "value": 100, "unit": "mg/dL",
   *     "refLow": 70, "refHigh": 100 }]`
   * `refLow`/`refHigh` son los del propio laboratorio y pueden faltar.
   */
  valuesJson Json @map("values_json")

  /// Ruta en Storage del PDF original, si se subió.
  filePath String? @map("file_path")
  notes    String?

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, kind, takenOn])
  @@index([userId, takenOn])
  @@map("lab_results")
}

// ---------------------------------------------------------------------------
// Coachy
// ---------------------------------------------------------------------------

model Conversation {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  date        DateTime         @default(now())
  role        ConversationRole
  text        String
  contextJson Json?            @map("context_json")

  @@index([userId, date])
  @@map("conversations")
}

/// Aviso in-app. El correo (Resend) es opcional: si no hay `RESEND_API_KEY`
/// la notificación existe igual y se ve dentro de la app.
model Notification {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  kind  NotificationKind
  title String
  body  String

  /// Enlace interno al que lleva el aviso, p. ej. `/app/checkin`.
  href String?

  /// Clave de idempotencia: un mismo recordatorio no se manda dos veces.
  /// Formato `{kind}:{userId}:{YYYY-MM-DD}`.
  dedupeKey String @unique @map("dedupe_key")

  readAt    DateTime? @map("read_at")
  emailedAt DateTime? @map("emailed_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("notifications")
