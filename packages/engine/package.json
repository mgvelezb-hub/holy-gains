{
  "name": "engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Motor determinista de dietas de Coachy: fases, ajuste semanal, macros, distribucion por comida y menus.",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./data/foods.json": "./data/foods.json",
    "./data/preparaciones.json": "./data/preparaciones.json"
